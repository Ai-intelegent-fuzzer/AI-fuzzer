# AI-Fuzzer configuration
APP_NAME=AI-Fuzzer
APP_VERSION=0.1.0

# Database is stored outside the repository by default. Optional overrides:
# AI_FUZZER_DB_PATH=%LOCALAPPDATA%\AI-Fuzzer\ai_fuzzer.sqlite3
# AI_FUZZER_DATABASE_URL=

# Required before saving API credentials to the database. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_FUZZER_CREDENTIAL_ENCRYPTION_KEY=

# Private endpoint exceptions are disabled by default.
AI_FUZZER_ALLOW_PRIVATE_TARGETS=false
AI_FUZZER_ALLOW_LOCAL_OLLAMA=false
# AI_FUZZER_ALLOWED_PROVIDER_HOSTS=provider.example

# Optional server-side provider-key fallbacks. Prefer entering credentials in
# the Targets page; never commit actual key values.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# MISTRAL_MODEL=
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
