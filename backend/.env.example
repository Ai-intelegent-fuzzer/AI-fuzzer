
# Copy to backend/.env. Never commit real API keys.
# Choose the provider in POST /targets: groq or openai.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Enable only for isolated local development with controlled private targets.
AI_FUZZER_ALLOW_PRIVATE_TARGETS=false

# Optional comma-separated hostnames for trusted compatible providers.
AI_FUZZER_ALLOWED_PROVIDER_HOSTS=
