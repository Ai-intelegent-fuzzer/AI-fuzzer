# Copy to backend/.env. Never commit real API keys.
# Choose the provider in POST /targets; provider can be "groq", "openai", or "gemini".
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gemini uses the official Generative Language API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
